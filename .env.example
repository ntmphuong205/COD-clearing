# Copy to .env and fill in. NEVER commit .env. NEVER put private keys in NEXT_PUBLIC_* variables.

# --- Fuji C-Chain (hub) ---
FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
EXPLORER_URL=https://testnet.snowtrace.io

# --- Carrier L1s (from the Builder Console, see RUNBOOK.md) ---
CARRIER_A_RPC=
CARRIER_B_RPC=
CARRIER_A_NAME="Carrier A"
CARRIER_B_NAME="Carrier B"
# Optional: the deploy script reads chain IDs and blockchain IDs from the chains themselves.
# CARRIER_A_CHAIN_ID=
# CARRIER_B_CHAIN_ID=
# HUB_BLOCKCHAIN_ID=0x...
# CARRIER_A_BLOCKCHAIN_ID=0x...
# CARRIER_B_BLOCKCHAIN_ID=0x...

# --- Wallets ---
# Deployer = hub owner = ledger admin. Needs AVAX on C-Chain and gas + TxAllowList access on both L1s.
DEPLOYER_KEY=0x...
# Carrier wallets own the escrows (addresses only; they fund escrows from the /carrier page).
CARRIER_A_ADDRESS=0x...
CARRIER_B_ADDRESS=0x...
# Demo seller and courier addresses (seed:fuji). Courier must be enabled in each L1's TxAllowList.
SELLER_ADDRESS=0x...
COURIER_ADDRESS=0x...
# Optional: if set, seed:fuji also marks the seeded orders "picked up" using this key.
# COURIER_KEY=0x...

# --- Frontend (public values only) ---
NEXT_PUBLIC_MODE=fuji
